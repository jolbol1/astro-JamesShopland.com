---
import type { Tag } from "@/types/types"

import { cn } from "@/lib/utils"

interface Props {
  categories: Tag[]
  /** The selected tag; its chip links back to all posts. */
  slug?: string
  "aria-labelledby"?: string
}

const { categories, slug, "aria-labelledby": ariaLabelledby } = Astro.props
---

<ul aria-labelledby={ariaLabelledby} class="flex list-none flex-wrap gap-2 p-0">
  {
    categories.map((item) => {
      const selected = item.slug === slug
      return (
        <li>
          <a
            href={selected ? "/blog" : `/tags/${item.slug}`}
            aria-current={selected ? "page" : undefined}
            class={cn(
              "inline-flex items-center gap-2 rounded-lg bg-blue-a-3 px-3 py-0.5 text-sm font-medium text-blue-a-11 ring-offset-background transition-colors hover:bg-blue-4",
              /* Focus Visible */
              "focus-visible:bg-blue-a-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-8 focus-visible:ring-offset-2",
              selected &&
                "bg-blue-a-9 text-blue-contrast hover:bg-blue-a-10 active:bg-blue-a-10 active:brightness-[1.08]"
            )}
          >
            {item.tag}
          </a>
        </li>
      )
    })
  }
</ul>
