---
import { getSecret } from "astro:env/server"

import { cached } from "@/lib/kv-cache"
import { getVideoStats } from "@/lib/videos"

import ChannelCards from "./channel-cards.astro"
import { channels } from "./channels"

interface Props {
  "aria-labelledby"?: string
}

const { "aria-labelledby": ariaLabelledby } = Astro.props as Props

const apiBaseUrl = getSecret("API_URL")?.replace(/\/+$/, "")
const apiKey = getSecret("API_KEY") ?? ""
const subscriberCountFormatter = new Intl.NumberFormat("en", {
  notation: "compact",
  maximumFractionDigits: 1,
})

async function loadSubscriberCount(baseUrl: string, channelHandle: string) {
  const response = await fetch(
    `${baseUrl}/channels/${encodeURIComponent(channelHandle)}`,
    {
      headers: {
        "x-api-key": apiKey,
      },
      signal: AbortSignal.timeout(5_000),
    }
  )

  if (!response.ok) {
    throw new Error(
      `Failed to fetch subscriber count for ${channelHandle}: ${response.status}`
    )
  }

  const data = await response.json<{
    channelStats?: { subscriberCount?: number | string }
  }>()
  const subscriberCount = Number(data.channelStats?.subscriberCount)

  if (!Number.isFinite(subscriberCount)) {
    throw new Error(`Invalid subscriber count for ${channelHandle}`)
  }

  return subscriberCount
}

async function getSubscriberCount(channelHandle: string) {
  if (!apiBaseUrl) {
    console.log("No API base URL")
    return null
  }

  const subscriberCount = await cached({
    key: `subscribers:v1:${channelHandle}`,
    load: () => loadSubscriberCount(apiBaseUrl, channelHandle),
  })

  return subscriberCount === null
    ? null
    : subscriberCountFormatter.format(subscriberCount)
}

// Shares the stats strip's cached youtube-data read, so the numbers match.
const ytdataSubscribers = (await getVideoStats())?.channelSubscribers

const channelsWithLiveCounts = await Promise.all(
  channels.map(async (channel) => {
    const subscribers =
      channel.subscribersFromYtdata && ytdataSubscribers != null
        ? subscriberCountFormatter.format(ytdataSubscribers)
        : await getSubscriberCount(channel.id)

    return { ...channel, subscribers: subscribers ?? channel.subscribers }
  })
)
---

<ChannelCards
  aria-labelledby={ariaLabelledby}
  channels={channelsWithLiveCounts}
/>
