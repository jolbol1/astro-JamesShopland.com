---
import BlueSky from "@/assets/icons/bluesky.svg"
import Github from "@/assets/icons/github.svg"
import LinkedIn from "@/assets/icons/linkedin.svg"
import Mail from "@/assets/icons/mail.svg"
import Twitter from "@/assets/icons/twitter.svg"
import YouTube from "@/assets/icons/youtube.svg"
import { siteConfig } from "site-config"

import Link from "@/components/ui/link.astro"
import IconWrapper from "@/components/icon-link.astro"

import { channels } from "./channels"

const navigation = [
  { href: "/", label: "Home" },
  { href: "/videos", label: "Videos" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
]
const linkClass = "h-fit w-full justify-start p-0 font-normal"
---

<footer class="relative mt-24 w-full max-w-6xl px-4 pb-6 pt-8 sm:px-8">
  <hr class="my-6" />

  <div class="flex flex-wrap justify-between gap-8">
    <div class="">
      <div class="">
        <div class="">
          <h2 class="text-lg font-medium uppercase text-blue-11">Follow me</h2>
          <p class="mb-2 mt-0 text-sm">Find me on any of these platforms.</p>
          <div class="flex lg:mb-0">
            <IconWrapper href={siteConfig.twitter} label="Twitter">
              <Twitter class="size-6" />
            </IconWrapper>
            <IconWrapper href={siteConfig.bluesky} label="BlueSky">
              <BlueSky class="size-6" />
            </IconWrapper>
            <IconWrapper href={siteConfig.youtube} label="YouTube">
              <YouTube class="size-6" />
            </IconWrapper>
            <IconWrapper href={siteConfig.github} label="GitHub">
              <Github class="size-6" />
            </IconWrapper>
            <IconWrapper href={siteConfig.linkedin} label="LinkedIn">
              <LinkedIn class="size-6" />
            </IconWrapper>
            <IconWrapper href={`mailto:${siteConfig.email}`} label="Email">
              <Mail class="size-6" />
            </IconWrapper>
          </div>
        </div>
      </div>
    </div>
    <div class="flex flex-wrap gap-8 sm:gap-16">
      <div>
        <h2 class="text-lg font-medium uppercase text-blue-11">YouTube</h2>
        <ul>
          {
            channels.map((channel) => (
              <li>
                <Link
                  class={linkClass}
                  variant="link"
                  href={channel.url}
                  target="_blank"
                  rel="noopener"
                >
                  {channel.name}
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-medium uppercase text-blue-11">Navigation</h2>
        <ul>
          {
            navigation.map(({ href, label }) => (
              <li>
                <Link class={linkClass} variant="link" href={href}>
                  {label}
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
  <hr class="my-6" />

  <div class="flex flex-wrap items-center justify-center md:justify-between">
    <div class="mx-auto w-full px-4 text-center">
      <div class="py-1 text-sm text-gray-a-11">
        Made with ❤️ by
        <Link variant="link" href="/" class="h-fit p-0 text-gray-a-11"
          >James Shopland</Link
        >
      </div>
    </div>
  </div>
</footer>
