---
import Link from "@/components/ui/link.astro"

interface Props {
  href: string
  label: string
}

const { href, label } = Astro.props
---

<Link
  aria-label={label}
  href={href}
  class="fill-gray-8 text-gray-8 hover:fill-gray-a-12"
  target="_blank"
  variant="ghost"
  size="icon"
  rel="noopener noreferrer"
>
  <slot />
</Link>
