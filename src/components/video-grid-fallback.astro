---
import { cn } from "@/lib/utils"
import type { VideoFormat } from "@/lib/videos"

interface Props {
  format: VideoFormat
  count: number
}

const { format, count } = Astro.props
---

<ul
  aria-hidden="true"
  class={cn(
    "grid list-none gap-6 p-0",
    format === "short"
      ? "grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6"
      : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
  )}
>
  {
    Array.from({ length: count }, () => (
      <li
        class={cn(
          "animate-pulse rounded-xl border bg-gray-a-2",
          format === "short" ? "aspect-[9/16]" : "aspect-[4/3]"
        )}
      />
    ))
  }
</ul>
