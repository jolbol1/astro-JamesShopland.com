---
import { cn } from "@/lib/utils"
import type { Video, VideoFormat } from "@/lib/videos"

import VideoCard from "./video-card.astro"

interface Props {
  videos: Video[]
  format: VideoFormat
  "aria-labelledby"?: string
}

const { videos, format, "aria-labelledby": ariaLabelledby } = Astro.props
---

<ul
  aria-labelledby={ariaLabelledby}
  class={cn(
    "grid list-none gap-6 p-0",
    format === "short"
      ? "grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6"
      : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
  )}
>
  {videos.map((video) => <VideoCard video={video} />)}
</ul>
