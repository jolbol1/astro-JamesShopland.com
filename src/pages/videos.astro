---
import Layout from "@/layouts/Layout.astro"

import VideoSection from "@/components/video-section.astro"
---

<Layout
  title="Videos"
  description="Videos and Shorts I've made for the Better Stack YouTube channel."
>
  <link slot="head" rel="preconnect" href="https://i.ytimg.com" />
  <div class="mx-auto mt-12 max-w-6xl px-4 sm:px-8">
    <h1
      class="my-12 max-w-2xl text-center text-4xl font-extrabold leading-none tracking-tight text-gray-12 sm:text-left md:text-5xl xl:text-6xl"
    >
      Videos
    </h1>
    <p class="text-gray-a-11 md:text-lg">
      Videos and Shorts I've made for the Better Stack YouTube channel.
    </p>
  </div>
  <VideoSection />
</Layout>
